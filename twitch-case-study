<script>
const track=document.getElementById('track');
const slides=track.querySelectorAll('.slide');
const total=slides.length;
const chevLeft=document.getElementById('chevLeft');
const chevRight=document.getElementById('chevRight');
const progressCurrent=document.getElementById('progressCurrent');
const progressDots=document.getElementById('progressDots');
let current=0;

for(let i=0;i<total;i++){
  const d=document.createElement('div');
  d.className='progress-dot'+(i===0?' active':'');
  progressDots.appendChild(d);
}

function goTo(n){
  current=Math.max(0,Math.min(total-1,n));
  track.style.transform=`translateX(-${current*100}vw)`;
  chevLeft.classList.toggle('hidden',current===0);
  chevRight.classList.toggle('hidden',current===total-1);
  progressCurrent.textContent=String(current+1).padStart(2,'0');
  document.querySelectorAll('.progress-dot').forEach((d,i)=>{
    d.classList.toggle('active',i===current);
  });
}

chevRight.addEventListener('click',()=>goTo(current+1));
chevLeft.addEventListener('click',()=>goTo(current-1));

document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key==='ArrowDown') goTo(current+1);
  if(e.key==='ArrowLeft'||e.key==='ArrowUp') goTo(current-1);
});

let touchStartX=0,touchStartY=0;
document.addEventListener('touchstart',e=>{touchStartX=e.touches[0].clientX;touchStartY=e.touches[0].clientY;},{passive:true});
document.addEventListener('touchend',e=>{
  const dx=e.changedTouches[0].clientX-touchStartX;
  const dy=e.changedTouches[0].clientY-touchStartY;
  if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>40){
    if(dx<0) goTo(current+1); else goTo(current-1);
  }
},{passive:true});

goTo(0);
</script>
</body>
</html>
